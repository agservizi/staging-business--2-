RewriteEngine On

# Redirect visible .php URLs to clean paths for safe browser navigations only.
RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
RewriteCond %{REQUEST_URI} ^(.+)\.php$ [NC]
RewriteCond %1 !/index$ [NC]
RewriteRule ^ %1 [R=301,L,NE]

# Normalise /index.php to /
RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
RewriteCond %{REQUEST_URI} ^(.*/)?index\.php$ [NC]
RewriteRule ^ %1 [R=301,L,NE]

# Serve existing files and directories as-is.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Resolve clean URLs to PHP files when they exist.
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.+?)/?$ $1.php [L,QSA]

# Resolve clean directory URLs to their index.php.
RewriteCond %{REQUEST_FILENAME}/index.php -f
RewriteRule ^(.+?)/?$ $1/index.php [L,QSA]
