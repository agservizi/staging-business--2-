{
  "root": true,
  "env": {
    "browser": true,
    "es2021": true
  },
  "extends": [
    "eslint:recommended",
    "plugin:import/recommended",
    "prettier"
  ],
  "parserOptions": {
    "ecmaVersion": 2021,
    "sourceType": "module"
  },
  "globals": {
    "bootstrap": "readonly",
    "DataTable": "readonly"
  },
  "overrides": [
    {
      "files": ["tools/**/*.js"],
      "env": {
        "node": true
      }
    }
  ],
  "rules": {
    "import/no-unresolved": "off"
  }
}
